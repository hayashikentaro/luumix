{
  "name": "@luumix/analysis",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "luumix": "./dist/src/cli.js"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "ai-input": "node ./dist/src/cli.js ai-input",
    "analyze": "node ./dist/src/cli.js analyze",
    "apply-ai-review": "node ./dist/src/cli.js apply-ai-review",
    "build": "tsc -p tsconfig.json",
    "init-overrides": "node ./dist/src/cli.js init-overrides",
    "report": "node ./dist/src/cli.js report",
    "resolve": "node ./dist/src/cli.js resolve",
    "test": "vitest run test/cli.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@luumix/metadata": "0.0.0"
  }
}
